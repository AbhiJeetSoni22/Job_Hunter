# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship_hunter
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db

# ── Gemini AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ── JWT Authentication ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Brevo HTTP API Email Service (OTP Authentication) ────────────────────
# Required in production on Render.
# Generates OTP verification emails via Brevo HTTPS API instead of SMTP.
# In local development, leaving BREVO_API_KEY empty logs verification codes
# directly to the terminal/logger.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Job Hunter

# ── Google OAuth 2.0 / OpenID Connect ───────────────────────────────────
# In production on Render:
# GOOGLE_REDIRECT_URI=https://job-hunter-fpii.onrender.com/api/auth/google/callback
# FRONTEND_URL=https://your-vercel-domain.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ── Application & CORS ──────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed origins (e.g. "http://localhost:3000,https://your-app.vercel.app")
CORS_ORIGINS=http://localhost:3000