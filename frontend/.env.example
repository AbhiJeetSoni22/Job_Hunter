# Backend API URL for server-side Next.js rewrites (Next.js server to backend)
# In production on Vercel: set to https://job-hunter-fpii.onrender.com
API_BASE_URL=http://localhost:8000

# Backend API URL for direct browser-level OAuth initiation (client-side)
# In production on Vercel: set to https://job-hunter-fpii.onrender.com
# IMPORTANT: In Vercel, redeploy after updating NEXT_PUBLIC_* variables so Next.js bundles them into the client build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
